# ---- required ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
SECRET_KEY=change-me-64-random-chars        # JWT signing key: openssl rand -hex 32
ENVIRONMENT=production
BOOTSTRAP_ADMIN_EMAIL=you@purify.digital    # created on first start if no users exist
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
CORS_ORIGINS=https://intel.example.com      # where the frontend is served

# ---- crawling policy --------------------------------------------------------
USER_AGENT=PurifyPublisherIntelligence/1.0 (+https://purify.digital/bot; publisher research)
RESPECT_ROBOTS_TXT=true
PER_HOST_MIN_INTERVAL_SECONDS=2
GLOBAL_MAX_CONCURRENT_FETCHES=32
HTTP_TIMEOUT_SECONDS=15
# never true in production (SSRF guard)
ALLOW_PRIVATE_NETWORK_FETCH=false

# ---- pipeline ----------------------------------------------------------------
CLASSIFICATION_MAX_PAGES=3
ADTECH_MAX_PAGES=3
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_CONCURRENCY=2
PLAYWRIGHT_TIMEOUT_MS=25000
PLAYWRIGHT_SETTLE_MS=6000
# CHROMIUM_EXECUTABLE=/usr/bin/chromium      # only if not using Playwright's bundled Chromium

# ---- discovery datasets -----------------------------------------------------
CRUX_MAX_RANK_BUCKET=100000
TRANCO_MAX_RANK=200000
# comma separated sellers.json URLs used by the sellers_discovery job
# SELLERS_JSON_SOURCES=https://www.google.com/sellers.json,https://pubmatic.com/sellers.json
